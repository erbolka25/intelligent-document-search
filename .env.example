# Copy to .env (in the project root) and fill in. Never commit .env.

# LLM: openai | anthropic | none (none = /ask shows passages only)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = provider default (openai: gpt-6-luna, anthropic: claude-opus-5-5)
LLM_MODEL=
# low | medium | high | xhigh | max  (low = fastest answers for the demo)
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=60

# Sign-in (required: without APP_PASSWORD nobody can log in)
APP_PASSWORD=change-me
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_MAX_AGE_S=28800
# auto = Secure cookie when the request arrives over HTTPS (also via X-Forwarded-Proto)
COOKIE_SECURE=auto

# Rate limits, requests per minute
LOGIN_RATE_PER_MIN=5
ASK_RATE_PER_MIN=20
UPLOAD_RATE_PER_MIN=30

# Retrieval
# faiss | numpy
INDEX_BACKEND=faiss
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=5
MIN_SCORE=0.75

# Ingestion
MAX_UPLOAD_MB=10
MAX_DOCUMENTS=50
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=100

# Storage and logging
DATA_DIR=data
LOG_LEVEL=INFO
